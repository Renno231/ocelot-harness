#!/usr/bin/env sh
set -eu

sbt_version=1.10.11
launcher_sha256=e988d533a020e5b60ec22c3b5df4cd3e3df465f4fdc3951c63036e21483978e4
launcher_url=${SBT_LAUNCHER_URL:-https://repo.maven.apache.org/maven2/org/scala-sbt/sbt-launch/$sbt_version/sbt-launch-$sbt_version.jar}
cache_root=${SBT_BOOTSTRAP_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/ocelot-harness/sbt}
launcher="$cache_root/sbt-launch-$sbt_version.jar"

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_directory/java-common.sh"
ocelot_select_java "$script_directory/.." build

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    printf '%s\n' 'ERROR: sha256sum or shasum is required to verify the SBT launcher' >&2
    exit 1
  fi
}

verify_launcher() {
  actual=$(sha256 "$1")
  if [ "$actual" != "$launcher_sha256" ]; then
    printf 'ERROR: SBT launcher checksum mismatch: expected %s, got %s\n' \
      "$launcher_sha256" "$actual" >&2
    return 1
  fi
}

mkdir -p "$cache_root"
if [ ! -f "$launcher" ]; then
  temporary="$launcher.tmp.$$"
  trap 'rm -f "$temporary"' EXIT HUP INT TERM
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --silent --show-error "$launcher_url" --output "$temporary"
  elif command -v wget >/dev/null 2>&1; then
    wget --quiet "$launcher_url" --output-document="$temporary"
  else
    printf '%s\n' 'ERROR: curl or wget is required to download the SBT launcher' >&2
    exit 1
  fi
  verify_launcher "$temporary"
  mv "$temporary" "$launcher"
  trap - EXIT HUP INT TERM
else
  verify_launcher "$launcher"
fi

exec "$ocelot_java" -jar "$launcher" "$@"
