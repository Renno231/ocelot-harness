#!/usr/bin/env sh
set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)
cd "$repository_root"

expected_brain_commit=bec1cc6b1e9e588692f753e9c617063c74967fed
actual_brain_commit=$(git -C lib/ocelot-brain rev-parse HEAD)
if [ "$actual_brain_commit" != "$expected_brain_commit" ]; then
  printf 'ERROR: ocelot-brain must be pinned to %s, found %s\n' \
    "$expected_brain_commit" "$actual_brain_commit" >&2
  exit 1
fi
if [ -n "$(git -C lib/ocelot-brain status --short)" ]; then
  printf '%s\n' 'ERROR: lib/ocelot-brain contains uncommitted changes' >&2
  exit 1
fi
printf 'PASS: clean ocelot-brain pin %s\n' "$actual_brain_commit"

"$script_directory/test-sbt-bootstrap"
"$script_directory/sbtw" \
  ';scalafmtCheckAll;harnessCore/clean;harnessApp/clean;harnessCore/compile;harnessApp/compile;harnessCore/test;harnessApp/test;harnessApp/assembly'

assembly_jar=modules/app/target/ocelot-harness.jar
if [ ! -f "$assembly_jar" ]; then
  printf 'ERROR: expected assembly was not created at %s\n' "$assembly_jar" >&2
  exit 1
fi
jar tf "$assembly_jar" | grep -Fxq 'META-INF/ocelot-harness/THIRD_PARTY_NOTICES.md'
jar tf "$assembly_jar" | grep -Fxq 'META-INF/ocelot-harness/sbom.cdx.json'
jar tf "$assembly_jar" | grep -Fxq 'META-INF/ocelot-harness/licenses/unifont-OFL-1.1.txt'
printf '%s\n' 'PASS: packaged release metadata and license notices'

viewer_help=$(java -cp "$assembly_jar" ocelot.harness.app.OcelotViewer --help)
case "$viewer_help" in
  'usage: ocelot-viewer '*) ;;
  *)
    printf '%s\n' 'ERROR: packaged viewer entrypoint is unavailable' >&2
    exit 1
    ;;
esac
printf '%s\n' 'PASS: packaged viewer entrypoint'

cli_help=$("$script_directory/ocelotctl" --help)
printf '%s\n' "$cli_help" | grep -Fq 'project inspect-desktop'
printf '%s\n' "$cli_help" | grep -Fq 'project import-desktop'
printf '%s\n' "$cli_help" | grep -Fq 'project validate'
printf '%s\n' 'PASS: packaged Desktop project commands'

smoke_directory=$(mktemp -d "${TMPDIR:-/tmp}/ocelot-harness-smoke.XXXXXX")
trap 'rm -rf "$smoke_directory"' EXIT HUP INT TERM
protocol_input="$smoke_directory/input.ndjson"
protocol_output="$smoke_directory/stdout.ndjson"
service_log="$smoke_directory/stderr.log"
project_directory="$smoke_directory/project with spaces"
mkdir -p "$project_directory"
cp -R fixtures/vertical-spike/. "$project_directory/"
cat >"$protocol_input" <<'EOF'
{"jsonrpc":"2.0","id":1,"method":"harness.version","params":{"protocolMajor":1}}
{"jsonrpc":"2.0","id":2,"method":"workspace.describe"}
{"jsonrpc":"2.0","id":3,"method":"machine.start","params":{"computerId":"main"}}
{"jsonrpc":"2.0","id":4,"method":"simulation.run","params":{"condition":{"type":"screen_contains","screenId":"main","text":"READY"},"maxTicks":2000,"timeoutMillis":10000}}
{"jsonrpc":"2.0","id":5,"method":"screen.capture","params":{"screenId":"main","path":"screens/packaged-protocol.png","format":"png"}}
{"jsonrpc":"2.0","id":6,"method":"snapshot.save","params":{"name":"packaged-ready"}}
{"jsonrpc":"2.0","id":7,"method":"screen.input","params":{"screenId":"main","input":{"type":"touch","x":1,"y":1}}}
{"jsonrpc":"2.0","id":8,"method":"simulation.run","params":{"condition":{"type":"screen_contains","screenId":"main","text":"TOUCHED"},"maxTicks":2000,"timeoutMillis":10000}}
{"jsonrpc":"2.0","id":9,"method":"snapshot.load","params":{"name":"packaged-ready"}}
{"jsonrpc":"2.0","id":10,"method":"screen.input","params":{"screenId":"main","input":{"type":"paste","text":"PACKAGED-SMOKE"}}}
{"jsonrpc":"2.0","id":11,"method":"simulation.run","params":{"condition":{"type":"screen_contains","screenId":"main","text":"PACKAGED-SMOKE"},"maxTicks":2000,"timeoutMillis":10000}}
{"jsonrpc":"2.0","id":12,"method":"diagnostics.collect","params":{"path":"diagnostics/packaged-protocol.zip"}}
{"jsonrpc":"2.0","id":13,"method":"service.shutdown"}
EOF
java -jar "$assembly_jar" serve --stdio --project "$project_directory" \
  <"$protocol_input" >"$protocol_output" 2>"$service_log"
if [ -s "$service_log" ]; then
  cat "$service_log" >&2
fi
[ "$(grep -c '"jsonrpc":"2.0"' "$protocol_output")" -eq 13 ]
if grep -Fq '"error"' "$protocol_output"; then
  printf '%s\n' 'ERROR: packaged protocol smoke returned an error' >&2
  exit 1
fi
awk 'index($0, "{\"jsonrpc\":\"2.0\"") != 1 { exit 1 }' "$protocol_output"
expected_harness_commit=$(git rev-parse HEAD)
grep -Fq '"protocolMajor":1' "$protocol_output"
grep -Fq "\"harnessCommit\":\"$expected_harness_commit\"" "$protocol_output"
grep -Fq '"brainCommit":"bec1cc6b1e9e588692f753e9c617063c74967fed"' "$protocol_output"
grep -Fq '"projectId":"vertical-spike"' "$protocol_output"
grep -Fq '"type":"condition_satisfied"' "$protocol_output"
grep -Fq '"relativePath":"screens/packaged-protocol.png"' "$protocol_output"
grep -Fq '"relativePath":"diagnostics/packaged-protocol.zip"' "$protocol_output"
grep -Fq '"shuttingDown":true' "$protocol_output"
printf '%s\n' 'PASS: packaged stdio protocol vertical smoke test'
